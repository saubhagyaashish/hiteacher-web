// Prisma Schema for Neon DB (Serverless PostgreSQL)
// Optimized for edge deployment with connection pooling

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"] // For edge compatibility
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // For migrations, bypasses pooling
}

// ============================================
// USERS & AUTHENTICATION
// ============================================

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  passwordHash String  @map("password_hash")
  name        String
  role        Role
  avatar      String?
  phoneNumber String?  @map("phone_number")
  status      UserStatus @default(ACTIVE)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Role-specific fields (nullable for other roles)
  // Teacher fields
  subjects            String[]
  experience          Int?
  qualification       String?
  bio                 String?
  verificationStatus  VerificationStatus? @map("verification_status")

  // Student fields
  enrollmentDate DateTime? @map("enrollment_date")
  parentName     String?   @map("parent_name")
  parentContact  String?   @map("parent_contact")

  // Admin fields
  permissions String[]

  // Relations
  teacherBatches    BatchTeacher[]
  studentBatches    BatchStudent[]
  assignments       Assignment[]
  submissions       Submission[]
  teacherClasses    Class[]          @relation("TeacherClasses")
  attendance        Attendance[]
  content           Content[]
  subjects_created  Subject[]
  refreshTokens     RefreshToken[]
  gradedSubmissions Submission[]     @relation("GradedBy")
  markedAttendance  Attendance[]     @relation("MarkedBy")

  @@index([email])
  @@index([role])
  @@index([status])
  @@map("users")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  revoked   Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

// ============================================
// BATCHES
// ============================================

model Batch {
  id          String      @id @default(uuid())
  name        String
  description String?
  subject     String
  startDate   DateTime    @map("start_date") @db.Date
  endDate     DateTime?   @map("end_date") @db.Date
  schedule    String?
  maxStudents Int?        @map("max_students")
  status      BatchStatus @default(ACTIVE)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  // Relations
  teachers        BatchTeacher[]
  students        BatchStudent[]
  settings        BatchSettings?
  accessRequests  BatchAccessRequest[]
  classes         Class[]
  assignments     AssignmentBatch[]
  content         ContentBatch[]

  @@index([status])
  @@index([subject])
  @@map("batches")
}

enum BatchStatus {
  ACTIVE
  INACTIVE
  COMPLETED
}

model BatchTeacher {
  batchId   String @map("batch_id")
  teacherId String @map("teacher_id")

  batch   Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  teacher User  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@id([batchId, teacherId])
  @@map("batch_teachers")
}

model BatchStudent {
  batchId    String   @map("batch_id")
  studentId  String   @map("student_id")
  enrolledAt DateTime @default(now()) @map("enrolled_at")

  batch   Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  student User  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([batchId, studentId])
  @@map("batch_students")
}

model BatchSettings {
  batchId             String    @id @map("batch_id")
  allowLateJoin       Boolean   @default(true) @map("allow_late_join")
  accessStartDate     DateTime? @map("access_start_date")
  accessEndDate       DateTime? @map("access_end_date")
  isVisible           Boolean   @default(true) @map("is_visible")
  autoApproveStudents Boolean   @default(false) @map("auto_approve_students")

  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@map("batch_settings")
}

model BatchAccessRequest {
  id           String              @id @default(uuid())
  batchId      String              @map("batch_id")
  studentId    String              @map("student_id")
  status       AccessRequestStatus @default(PENDING)
  requestDate  DateTime            @default(now()) @map("request_date")
  responseDate DateTime?           @map("response_date")
  message      String?

  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, studentId])
  @@map("batch_access_requests")
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// ============================================
// ASSIGNMENTS
// ============================================

model Assignment {
  id                  String             @id @default(uuid())
  title               String
  description         String
  instructions        String             @db.Text
  type                AssignmentType
  status              AssignmentStatus   @default(DRAFT)
  gradingType         GradingType        @default(POINTS)
  maxPoints           Int                @map("max_points")
  passingScore        Int?               @map("passing_score")
  dueDate             DateTime           @map("due_date")
  assignedDate        DateTime           @default(now()) @map("assigned_date")
  allowLateSubmission Boolean            @default(false) @map("allow_late_submission")
  teacherId           String             @map("teacher_id")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  // Relations
  teacher          User                   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  batches          AssignmentBatch[]
  attachments      AssignmentAttachment[]
  submissions      Submission[]
  linkedContent    AssignmentContent[]

  @@index([teacherId])
  @@index([status])
  @@index([dueDate])
  @@map("assignments")
}

enum AssignmentType {
  TEXT
  FILE
  LINK
  QUIZ
}

enum AssignmentStatus {
  ACTIVE
  CLOSED
  DRAFT
}

enum GradingType {
  POINTS
  PASSFAIL
}

model AssignmentBatch {
  assignmentId String @map("assignment_id")
  batchId      String @map("batch_id")

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  batch      Batch      @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@id([assignmentId, batchId])
  @@map("assignment_batches")
}

model AssignmentAttachment {
  id           String @id @default(uuid())
  assignmentId String @map("assignment_id")
  fileName     String @map("file_name")
  fileUrl      String @map("file_url")
  fileSize     BigInt @map("file_size")
  fileType     String @map("file_type")

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@map("assignment_attachments")
}

model Submission {
  id           String           @id @default(uuid())
  assignmentId String           @map("assignment_id")
  studentId    String           @map("student_id")
  type         AssignmentType
  textContent  String?          @map("text_content") @db.Text
  fileUrl      String?          @map("file_url")
  fileName     String?          @map("file_name")
  fileSize     BigInt?          @map("file_size")
  linkUrl      String?          @map("link_url")
  status       SubmissionStatus @default(PENDING)
  submittedAt  DateTime         @default(now()) @map("submitted_at")
  isLate       Boolean          @default(false) @map("is_late")
  grade        Int?
  maxPoints    Int              @map("max_points")
  feedback     String?          @db.Text
  gradedAt     DateTime?        @map("graded_at")
  gradedBy     String?          @map("graded_by")
  version      Int              @default(1)

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  grader     User?      @relation("GradedBy", fields: [gradedBy], references: [id])

  @@unique([assignmentId, studentId, version])
  @@index([assignmentId])
  @@index([studentId])
  @@index([status])
  @@map("submissions")
}

enum SubmissionStatus {
  PENDING
  SUBMITTED
  GRADED
  LATE
}

// ============================================
// CLASSES & ATTENDANCE
// ============================================

model Class {
  id                String       @id @default(uuid())
  batchId           String       @map("batch_id")
  teacherId         String       @map("teacher_id")
  title             String
  topic             String
  description       String?      @db.Text
  startTime         DateTime     @map("start_time")
  endTime           DateTime     @map("end_time")
  duration          Int // minutes
  status            ClassStatus  @default(SCHEDULED)
  meetingPlatform   String?      @map("meeting_platform")
  meetingUrl        String?      @map("meeting_url")
  meetingId         String?      @map("meeting_id")
  meetingPassword   String?      @map("meeting_password")
  meetingNotes      String?      @map("meeting_notes") @db.Text
  notes             String?      @db.Text
  topicsCovered     String[]     @map("topics_covered")
  homeworkAssigned  String?      @map("homework_assigned") @db.Text
  isRecurring       Boolean      @default(false) @map("is_recurring")
  recurringGroupId  String?      @map("recurring_group_id")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  batch      Batch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  teacher    User         @relation("TeacherClasses", fields: [teacherId], references: [id], onDelete: Cascade)
  attendance Attendance[]

  @@index([batchId])
  @@index([teacherId])
  @@index([status])
  @@index([startTime])
  @@index([recurringGroupId])
  @@map("classes")
}

enum ClassStatus {
  SCHEDULED
  ONGOING
  COMPLETED
  CANCELLED
}

model Attendance {
  id        String           @id @default(uuid())
  classId   String           @map("class_id")
  studentId String           @map("student_id")
  status    AttendanceStatus
  markedAt  DateTime         @default(now()) @map("marked_at")
  markedBy  String?          @map("marked_by")
  notes     String?          @db.Text

  class    Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  student  User  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  marker   User? @relation("MarkedBy", fields: [markedBy], references: [id])

  @@unique([classId, studentId])
  @@index([classId])
  @@index([studentId])
  @@map("attendance")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

// ============================================
// CONTENT MANAGEMENT
// ============================================

model Content {
  id               String        @id @default(uuid())
  title            String
  description      String        @db.Text
  type             ContentType
  status           ContentStatus @default(DRAFT)
  category         String
  tags             String[]
  thumbnail        String?
  content          String        @db.Text
  fileUrl          String?       @map("file_url")
  fileName         String?       @map("file_name")
  fileSize         BigInt?       @map("file_size")
  duration         Int? // minutes
  views            Int           @default(0)
  commentsEnabled  Boolean       @default(true) @map("comments_enabled")
  downloadEnabled  Boolean       @default(true) @map("download_enabled")
  teacherId        String        @map("teacher_id")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  scheduledAt      DateTime?     @map("scheduled_at")

  teacher           User                @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  batches           ContentBatch[]
  linkedAssignments AssignmentContent[]
  chapterContent    ChapterContent[]

  @@index([teacherId])
  @@index([type])
  @@index([status])
  @@index([category])
  @@map("content")
}

enum ContentType {
  LESSON
  VIDEO
  DOCUMENT
  QUIZ
}

enum ContentStatus {
  PUBLISHED
  DRAFT
  SCHEDULED
}

model ContentBatch {
  contentId String @map("content_id")
  batchId   String @map("batch_id")

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  batch   Batch   @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@id([contentId, batchId])
  @@map("content_batches")
}

model AssignmentContent {
  assignmentId String @map("assignment_id")
  contentId    String @map("content_id")

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  content    Content    @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@id([assignmentId, contentId])
  @@map("assignment_content")
}

// ============================================
// SUBJECT HIERARCHY
// ============================================

model Subject {
  id          String   @id @default(uuid())
  name        String
  description String?  @db.Text
  icon        String?
  color       String?
  teacherId   String   @map("teacher_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  teacher User    @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  topics  Topic[]

  @@map("subjects")
}

model Topic {
  id          String   @id @default(uuid())
  subjectId   String   @map("subject_id")
  name        String
  description String?  @db.Text
  orderIndex  Int      @map("order_index")
  createdAt   DateTime @default(now()) @map("created_at")

  subject  Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  chapters Chapter[]

  @@index([subjectId])
  @@map("topics")
}

model Chapter {
  id          String   @id @default(uuid())
  topicId     String   @map("topic_id")
  name        String
  description String?  @db.Text
  orderIndex  Int      @map("order_index")
  createdAt   DateTime @default(now()) @map("created_at")

  topic   Topic            @relation(fields: [topicId], references: [id], onDelete: Cascade)
  content ChapterContent[]

  @@index([topicId])
  @@map("chapters")
}

model ChapterContent {
  chapterId String @map("chapter_id")
  contentId String @map("content_id")

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@id([chapterId, contentId])
  @@map("chapter_content")
}
